# 概览 / Overview: 本地开发环境变量模板。复制为 .env 后使用；.env 不进 git。
# Local development env template. Copy to .env; .env is never committed.

# 数据库账号（仅本地 Docker 使用）/ Database credentials (local Docker only)
POSTGRES_USER=sig
POSTGRES_PASSWORD=sig_local_dev
POSTGRES_DB=sig

# 后端在宿主机直接运行（如跑集成测试）时使用的连接串；容器内由 docker-compose.yml 拼出指向 db 的地址。
# Connection string for running the backend/tests on the host; inside Compose the URL points at service "db".
DATABASE_URL=postgresql+psycopg://sig:sig_local_dev@localhost:5432/sig
